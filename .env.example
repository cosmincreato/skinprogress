# PostgreSQL database username
POSTGRES_USER=
# PostgreSQL database password
POSTGRES_PASSWORD=
# PostgreSQL database name
POSTGRES_DB=
# PostgreSQL port
DB_PORT=
# PostgreSQL host
DB_HOST=

# Connection string for backend to connect to database
DB_CONNECTION_STRING=

# JWT secret key for token generation
JWT_KEY=
# JWT token issuer
JWT_ISSUER=
# JWT token audience
JWT_AUDIENCE=
# JWT token expiration in hours
JWT_EXPIRATION_HOURS=

# Encryption key for sensitive data (must be Base64 encoded)
ENCRYPTION_KEY=

# Google OAuth 2.0 Client ID from https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# Email service provider (console, sendgrid, or smtp)
EMAIL_PROVIDER=
# Email address to send from
EMAIL_FROM_ADDRESS=
# Email display name
EMAIL_FROM_NAME=
# SendGrid API key (if using SendGrid)
SENDGRID_API_KEY=
# SMTP server hostname (if using SMTP)
SMTP_HOST=
# SMTP server port
SMTP_PORT=
# SMTP username
SMTP_USERNAME=
# SMTP password
SMTP_PASSWORD=

# Frontend application base URL
APP_BASE_URL=
# Backend API base URL
API_BASE_URL=

# Frontend: Google OAuth 2.0 Client ID (Vite prefix required)
VITE_GOOGLE_CLIENT_ID=
# Frontend: Backend API endpoint
VITE_API_BASE_URL=

# AI Service: Main model backend to use
MODEL_BACKEND=
# AI Service: Preload models on startup
PRELOAD_MODELS=

# AI Service: Enable heatmap visualization
HEATMAP_ENABLED=
# AI Service: Heatmap visualization backend
HEATMAP_BACKEND=

# AI Service: Acne detection confidence threshold (lower = more sensitive)
ACNE_DETECT_CONF=
# AI Service: IoU threshold for non-maximum suppression
ACNE_DETECT_IOU=
# AI Service: Maximum detections per image
ACNE_DETECT_MAX_DET=

# AI Service: CLIP model identifier
CLIP_MODEL_ID=
# AI Service: Acne analysis model identifier
ACNE_MODEL_ID=
# AI Service: Acne detection model repository
ACNE_DETECT_MODEL_REPO=
# AI Service: Acne detection model file
ACNE_DETECT_MODEL_FILE=

# AI Service: Heatmap circle radius ratio
ACNE_HEATMAP_RADIUS_RATIO=
# AI Service: Heatmap transparency (0-255)
UNIFORM_FACE_ALPHA=

# Hugging Face cache directory for models
HF_HOME=

# AI Service port
AI_SERVICE_PORT=
# AI Service base URL
AI_SERVICE_BASE_URL=

# Docker Compose project name
COMPOSE_PROJECT_NAME=

# Application environment (development, staging, production)
ENVIRONMENT=
# Log level (debug, info, warning, error)
LOG_LEVEL=
# Log level (debug, info, warning, error)
LOG_LEVEL=debug
