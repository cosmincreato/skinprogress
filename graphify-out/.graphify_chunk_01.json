    },
    {
      "id": "concept_face3d_coordinate_coloring",
      "label": "Face3D Coordinate-Based Vertex Coloring",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-29-face3d-coordinate-based-coloring-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "scoreToHeat() zone-based coloring produces unnatural yellow/brown patches unrelated to actual skin tone. Replacing with detection-based coordinate hit-testing against AI output, using median skin tone as base and clinically meaningful condition colors, produces a more accurate diagnostic visualization."
    },
    {
      "id": "concept_median_skin_color",
      "label": "Median Skin Color Extraction",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-29-face3d-coordinate-based-coloring-design.md",
      "source_location": null,
