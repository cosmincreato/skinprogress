    },
    {
      "id": "concept_habit_lock_in",
      "label": "Habit Lock-In UX Pattern",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-29-habit-lock-in-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Direct checkbox-to-DB write with no confirmation step makes it easy to accidentally log a habit. The Lock In two-step (check → confirm) makes the action deliberate and irreversible, matching the backend's already-irreversible behavior."
    },
    {
      "id": "concept_lock_state_type",
