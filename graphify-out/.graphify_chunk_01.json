    {
      "id": "concept_qdrant_activity_log",
      "label": "Qdrant Activity Log Collection",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-29-qdrant-activity-log-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Bloom chatbot needs to accurately retrieve a user's historical skin data. A dedicated 1024-dim bge-m3 embedded collection (skinprogress_activity_log) separate from the 8-dim skinprogress_analyses allows semantic search over natural language event text while preserving exact numeric metadata for filtering."
