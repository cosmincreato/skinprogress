    {
      "id": "concept_face_landmarker_tasks_api",
      "label": "MediaPipe FaceLandmarker Tasks API",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-mediapipe-tasks-api-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "mp.solutions.face_mesh was removed in mediapipe 0.10.35 on Python 3.14, causing all face detection to fall through to center-ellipse fallback. The Tasks API (mp.tasks.vision.FaceLandmarker) replaces it with a model-file-based approach that correctly handles side-profile selfies."
    },
    {
      "id": "concept_face_silhouette_mask",
      "label": "Face Silhouette Polygon Mask",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-landmark-detection-tuning-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Using 36 specific MediaPipe landmark indices that trace the exact face boundary instead of rectangular bbox with percentage expansion, to exclude hair at top edges and provide tighter face region for skin analysis."
    },
    {
      "id": "concept_nostril_exclusion_mask",
      "label": "Nostril Exclusion Mask",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-landmark-detection-tuning-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dark circular nostril openings match the acne color profile (dark, slightly reddish), causing false positives. Subtracting a nostril polygon (8 landmark indices) from the face silhouette eliminates this source of error."
    },
    {
      "id": "concept_yolo_face_crop",
      "label": "YOLO Face-Crop-First Detection",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-face-crop-detection-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "YOLO running on the full selfie image detects acne-like spots on hands, hair, and background. Cropping to face region first means YOLO physically cannot detect anything outside the face crop."
    },
    {
      "id": "concept_composite_heatmap",
      "label": "Per-Condition Composite Heatmap",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-heatmap-condition-tooltips-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single green-yellow-red gradient heatmap gives no information about which condition each region represents. Per-condition colors (acne=red, redness=orange, under-eye bags=purple) plus JSON detection metadata allow frontend to render tooltips and drive 3D model vertex coloring."
    },
    {
      "id": "concept_detection_type",
      "label": "Detection Type (spot/zone)",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-heatmap-condition-tooltips-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "concept_heatmap_overlay_component",
      "label": "HeatmapOverlay React Component",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-28-heatmap-condition-tooltips-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
