        </mxCell>

        <mxCell id="46" value="H_bags(x,y)  =  clip( (P55 − g(x,y)) / (P55 − P15),  0, 1 )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontStyle=2;" vertex="1" parent="40">
