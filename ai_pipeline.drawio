        <mxCell id="45" value="Percentile normalization: P15 (bright anchor) · P55 (dark anchor)&lt;br&gt;Darker pixels → higher heatmap value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="40">
