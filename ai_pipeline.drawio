        <mxCell id="2" value="&lt;b&gt;3 Selfie Photos&lt;/b&gt;&lt;br&gt;Front · Left · Right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="625" y="20" width="500" height="55" as="geometry" />
        </mxCell>

        <!-- SHARED PREPROCESSING SWIMLANE -->
        <mxCell id="3" value="SHARED PREPROCESSING" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;horizontal=1;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1650" height="140" as="geometry" />
        </mxCell>

        <!-- Face Detection box (child of swimlane 3) -->
        <mxCell id="4" value="&lt;b&gt;Face Region Detection&lt;/b&gt;&lt;br&gt;MediaPipe FaceLandmarker Tasks API — 478 landmarks&lt;br&gt;Silhouette mask (36 indices) · Nostril exclusion (convex hull, 23 indices)&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;Fallbacks: flip &amp; retry → Haar cascade → center ellipse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="3">
          <mxGeometry x="10" y="38" width="795" height="92" as="geometry" />
        </mxCell>

        <!-- Skin Masking box (child of swimlane 3) -->
        <mxCell id="5" value="&lt;b&gt;Skin Tone Masking&lt;/b&gt;&lt;br&gt;YCrCb color space&lt;br&gt;40 &lt; Y &lt; 240 · 130 &lt; Cr &lt; 170 · 80 &lt; Cb &lt; 135&lt;br&gt;Morphological closing (7×7 elliptical kernel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="3">
          <mxGeometry x="845" y="38" width="795" height="92" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════
             ACNE COLUMN
        ══════════════════════════════════════ -->
        <mxCell id="10" value="ACNE" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="500" height="660" as="geometry" />
        </mxCell>

        <mxCell id="11" value="— HEATMAP —" style="text;html=1;align=center;fontStyle=2;fontSize=9;fontColor=#888888;" vertex="1" parent="10">
          <mxGeometry x="0" y="32" width="500" height="18" as="geometry" />
        </mxCell>

        <mxCell id="12" value="Crop image to face bounding box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="10">
          <mxGeometry x="10" y="55" width="480" height="36" as="geometry" />
        </mxCell>

        <mxCell id="13" value="&lt;b&gt;YOLOv8 Acne Detector&lt;/b&gt;&lt;br&gt;conf=0.15 · iou=0.45 · max_det=250" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="10">
          <mxGeometry x="10" y="110" width="290" height="50" as="geometry" />
        </mxCell>

        <mxCell id="14" value="&lt;b&gt;HSV Blemish Detector&lt;/b&gt;&lt;br&gt;&lt;i&gt;fallback if no detections&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="320" y="110" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="15" value="Gaussian blobs · element-wise maximum&lt;br&gt;B_i(x,y) = c_i · exp(−((x−xi)²+(y−yi)²) / 2σi²)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="10">
          <mxGeometry x="10" y="180" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="16" value="H_acne(x,y)  =  max_i  B_i(x,y)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontStyle=2;" vertex="1" parent="10">
          <mxGeometry x="10" y="248" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="17" value="" style="line;strokeColor=#d79b00;" vertex="1" parent="10">
          <mxGeometry x="10" y="288" width="480" height="8" as="geometry" />
        </mxCell>

        <mxCell id="18" value="— SCORING —" style="text;html=1;align=center;fontStyle=2;fontSize=9;fontColor=#888888;" vertex="1" parent="10">
          <mxGeometry x="0" y="296" width="500" height="18" as="geometry" />
        </mxCell>

        <mxCell id="19" value="HSV blemish count N&lt;br&gt;+ mean severity S̄  (per-pixel darkness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="10">
          <mxGeometry x="10" y="320" width="290" height="50" as="geometry" />
        </mxCell>

        <mxCell id="20" value="&lt;b&gt;Skintelligent Classifier&lt;/b&gt;&lt;br&gt;&lt;i&gt;fallback if N = 0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="10">
          <mxGeometry x="320" y="320" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="21" value="Score = 0.6 · min(N/20, 1)  +  0.4 · S̄&lt;br&gt;&lt;i&gt;or&lt;/i&gt;  Score = (E[s] + 1) / 5   (classifier path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontStyle=2;" vertex="1" parent="10">
          <mxGeometry x="10" y="390" width="480" height="42" as="geometry" />
        </mxCell>

        <mxCell id="22" value="Acne Score  [0, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="10">
