          <mxGeometry x="0" y="32" width="500" height="18" as="geometry" />
        </mxCell>

        <mxCell id="32" value="Convert to CIELAB color space&lt;br&gt;Extract a* channel  (green ↔ red opponent axis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="30">
          <mxGeometry x="10" y="55" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="33" value="Mask to detected skin region&lt;br&gt;Percentile normalization: P55 (low anchor) · P92 (high anchor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="30">
          <mxGeometry x="10" y="125" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="34" value="H_redness(x,y)  =  clip( (a*(x,y) − P55) / (P92 − P55),  0, 1 )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontStyle=2;" vertex="1" parent="30">
