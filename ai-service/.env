# General App Settings
MODEL_BACKEND=acne_severity
PRELOAD_MODELS=1

# Heatmap Configuration
HEATMAP_ENABLED=1
HEATMAP_BACKEND=uniform_face

# Detection Sensitivity
# Lowering this helps if you are far from the camera or in dim lighting
ACNE_DETECT_CONF=0.15
ACNE_DETECT_IOU=0.45
ACNE_DETECT_MAX_DET=250

# Model IDs
CLIP_MODEL_ID=openai/clip-vit-base-patch32
ACNE_MODEL_ID=imfarzanansari/skintelligent-acne
ACNE_DETECT_MODEL_REPO=Tinny-Robot/acne
ACNE_DETECT_MODEL_FILE=acne.pt

# Visual Tweaks
ACNE_HEATMAP_RADIUS_RATIO=0.6
UNIFORM_FACE_ALPHA=120