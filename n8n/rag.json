    {
      "parameters": {
        "content": "### Send Chat Message\n\nAsk a question and receive an answer based on the knowledge base",
        "height": 112,
        "width": 304
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2192,
